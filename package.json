{
  "name": "alethe",
  "version": "0.3.0",
  "private": true,
  "description": "ALETHE — il gioco giornaliero del giudizio. Static app + Cloudflare Pages Functions + D1.",
  "scripts": {
    "dev": "wrangler pages dev . --port 8080",
    "dev:static": "npx -y serve -l 8080 .",
    "db:migrate:local": "wrangler d1 migrations apply alethe-db --local",
    "db:migrate": "wrangler d1 migrations apply alethe-db --remote",
    "deploy": "wrangler pages deploy ."
  }
}
